{
  "name": "ai-tahmin-sanati",
  "private": true,
  "version": "1.0.0",
  "description": "AI Tahmin Sanatı - Futbol Tahmin Uygulaması",
  "author": {
    "name": "Mustafa Paçiman"
  },
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "dev:all": "vite --port 3000",
    "build": "CI=false NODE_ENV=development vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:dev": "cross-env ELECTRON=true concurrently -k \"vite --port 3000\" \"wait-on tcp:3000 && electron .\"",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder",
    "clean": "rimraf dist node_modules/.vite",
    "rebuild": "npm run clean && npm install && npm run build",
    "dev:light": "cross-env ELECTRON=true electron .",
    "dev:prod": "vite preview",
    "electron:light": "cross-env ELECTRON=true NODE_ENV=production concurrently -k \"vite --port 3000\" \"wait-on tcp:3000 && electron .\""
  },
  "build": {
    "appId": "com.patsi.predictions",
    "productName": "AI Tahmin Sanatı",
    "directories": {
      "output": "releases"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "your-github-username",
      "repo": "your-repo-name"
    }
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@types/date-fns": "^2.5.3",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-router-dom": "^5.3.3",
    "antd": "^5.23.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.344.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-hot-toast": "^2.5.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/lz-string": "^1.3.34",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "local-cors-proxy": "^1.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  }
}
