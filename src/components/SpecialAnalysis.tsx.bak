        </div>
      `);
    }
  }

  // Takım 2 için benzer analizler
  if (team2SurpriseCount > 0) {
    const team2Patterns = analyzeMatchPatterns(team2Surprises);
    const team2OddPatterns = analyzeOddPatterns(team2Surprises);
    const team2FormPatterns = analyzePreSurpriseForm(matchData, team2Surprises, team2Name);
    const team2SeasonStats = analyzeSeasonDistribution(team2Surprises);
    const team2GoalTiming = analyzeGoalTiming(team2Surprises);
    const team2OddsMovement = analyzeOddsMovement(team2Surprises);

    // Sezon dağılımı analizi
    const seasonAnalysis = Object.entries(team2SeasonStats)
