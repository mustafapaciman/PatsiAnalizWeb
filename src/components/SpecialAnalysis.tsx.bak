                          <div className="absolute -top-8 left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                            {idx === 0 ? 'En Eski Maç' : idx === 1 ? 'Orta Maç' : 'En Yeni Maç'}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>

            <div>
              <div className="flex items-center justify-between mb-2">
                <label className="text-sm font-medium text-gray-700">Son 3 Maç Skorları (Dep)</label>
                {calculationData.awayScores && calculationData.awayScores.length > 0 && (
                  <button
                    onClick={() => setCalculationData(prev => ({ ...prev, awayScores: [] }))}
                    className="text-xs text-red-500 hover:text-red-600"
                  >
                    Sıfırla
                  </button>
                )}
              </div>
              <div className="bg-gray-50 rounded-lg p-4">
