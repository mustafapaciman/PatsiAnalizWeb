}

// Oran tiplerini tanımla
const ODD_TYPES: { [key: string]: string } = {
  // Bet365 Oranları
  'B365H': 'Bet365 Ev Sahibi',
  'B365D': 'Bet365 Beraberlik',
  'B365A': 'Bet365 Deplasman',
  'B365CH': 'Bet365 Ev Sahibi (Kapanış)',
  'B365CD': 'Bet365 Beraberlik (Kapanış)',
  'B365CA': 'Bet365 Deplasman (Kapanış)',
  'B365>2.5': 'Bet365 2.5 Üst',
  'B365<2.5': 'Bet365 2.5 Alt',
  'B365AHH': 'Bet365 Handikap Ev',
  'B365AHA': 'Bet365 Handikap Dep',
  'B365CAHH': 'Bet365 Handikap Ev (Kapanış)',
  'B365CAHA': 'Bet365 Handikap Dep (Kapanış)',
  // Diğer Bookmakerlar
  'BWH': 'Bet&Win Ev Sahibi',
  'BWD': 'Bet&Win Beraberlik',
  'BWA': 'Bet&Win Deplasman',
  'IWH': 'Interwetten Ev Sahibi',
  'IWD': 'Interwetten Beraberlik',
  'IWA': 'Interwetten Deplasman',
  'PSH': 'Pinnacle Ev Sahibi',
  'PSD': 'Pinnacle Beraberlik',
  'PSA': 'Pinnacle Deplasman',
  'WHH': 'William Hill Ev Sahibi',
  'WHD': 'William Hill Beraberlik',
  'WHA': 'William Hill Deplasman',
  'VCH': 'VC Bet Ev Sahibi',
  'VCD': 'VC Bet Beraberlik',
  'VCA': 'VC Bet Deplasman',
  // Genel İstatistikler
  'MaxH': 'En Yüksek Ev Sahibi',
  'MaxD': 'En Yüksek Beraberlik',
  'MaxA': 'En Yüksek Deplasman',
  'AvgH': 'Ortalama Ev Sahibi',
  'AvgD': 'Ortalama Beraberlik',
  'AvgA': 'Ortalama Deplasman'
};

// Oran gösterimini formatla
const formatOddDisplay = (oddKey: string, oddValue: number): string => {
  const isClosingOdd = oddKey.includes('C') && !oddKey.startsWith('VC');
  const oddName = ODD_TYPES[oddKey] || oddKey;
  const formattedValue = oddValue.toFixed(2);
  return `${oddName}: ${formattedValue}${isClosingOdd ? ' (Kapanış)' : ''}`;
};

// Excel tarihini normal tarihe çeviren fonksiyon
const convertExcelDate = (excelDate: number | string): string => {
  // Excel tarihi 1900'den başlar ve geçen gün sayısını temsil eder
  const EXCEL_START_DATE = new Date(1900, 0, 1);
  
  // String ise sayıya çevir
  const numericDate = typeof excelDate === 'string' ? parseInt(excelDate) : excelDate;
  
  // Geçerli bir sayı değilse orijinal değeri döndür
  if (!Number.isFinite(numericDate)) return String(excelDate);
  
  // Excel'in 1900'ü artık yıl sayma hatasını düzelt
  const adjustedDate = numericDate <= 60 ? numericDate - 1 : numericDate - 2;
  
  // Milisaniyeye çevir ve başlangıç tarihine ekle
  const date = new Date(EXCEL_START_DATE.getTime() + (adjustedDate * 24 * 60 * 60 * 1000));
  
  // Tarihi formatla
  const day = date.getDate().toString().padStart(2, '0');
  const month = (date.getMonth() + 1).toString().padStart(2, '0');
  const year = date.getFullYear();
  
  return `${day}.${month}.${year}`;
};

// Sürpriz öncesi skor örüntülerini analiz et
function analyzePreSurpriseScores(matches: Match[], surpriseMatches: Match[]) {
  const scores: { [key: string]: number } = {};
  surpriseMatches.forEach(sm => {
    const preMatch = matches
      .filter(m => new Date(m.Date) < new Date(sm.Date))
      .sort((a, b) => new Date(b.Date).getTime() - new Date(a.Date).getTime())[0];
    
    if (preMatch) {
      const score = `${preMatch.FTHG}-${preMatch.FTAG}`;
      scores[score] = (scores[score] || 0) + 1;
    }
  });

  // Skorları yüzdeye göre sırala
  const total = Object.values(scores).reduce((sum, count) => sum + count, 0);
  const sortedScores: { [key: string]: number } = {};
  
  Object.entries(scores)
    .map(([score, count]) => ({
      score,
      percentage: (count / total) * 100
    }))
    .sort((a, b) => b.percentage - a.percentage)
    .forEach(({ score, percentage }) => {
      sortedScores[score] = scores[score];
    });

  return sortedScores;
}

// Kırmızı kart etkisini analiz et
function analyzeRedCardImpact(matches: Match[]) {
  const impact: { [key: string]: number } = {
    "Kırmızı Kartlı": 0,
    "Kartsız": 0
  };
  matches.forEach(m => {
    if (m.RC && m.RC > 0) {
      impact["Kırmızı Kartlı"]++;
    } else {
      impact["Kartsız"]++;
    }
  });
  return impact;
}

// AI analizi oluştur
function createAIAnalysis(
  team1Surprises: Match[], 
  team2Surprises: Match[],
  team1PreScores: { [key: string]: number },
  team2PreScores: { [key: string]: number },
  team1Name: string,
  team2Name: string,
  matchData: Match[]
) {
  const analysis: { 
    team1Analysis: string[], 
    team2Analysis: string[],
    generalAnalysis: string[]
  } = {
    team1Analysis: [],
    team2Analysis: [],
    generalAnalysis: []
  };

  // Sürpriz maç sayılarını analiz et
  const team1SurpriseCount = team1Surprises.length;
  const team2SurpriseCount = team2Surprises.length;

  // Yeni: Sürpriz maçların sezon dağılımını analiz et
  function analyzeSeasonDistribution(matches: Match[]) {
    const seasonStats: { [key: string]: number } = {};
    matches.forEach(match => {
      const date = new Date(convertExcelDate(match.Date));
      const month = date.getMonth() + 1;
      const season = month >= 8 ? "İlk Yarı" : "İkinci Yarı";
      seasonStats[season] = (seasonStats[season] || 0) + 1;
    });
    return seasonStats;
  }

  // Yeni: Gol zamanlaması analizi
  function analyzeGoalTiming(matches: Match[]) {
    const timingStats = {
      firstHalf: 0,
      secondHalf: 0,
      last15: 0
    };

    matches.forEach(match => {
      if (match.Time) {
        const time = typeof match.Time === 'number' ? match.Time : parseInt(match.Time);
        if (time <= 45) timingStats.firstHalf++;
        else timingStats.secondHalf++;
        if (time >= 75) timingStats.last15++;
      }
    });

    return timingStats;
  }

  // Yeni: Oran değişimi analizi
  function analyzeOddsMovement(matches: Match[]) {
    const movements = {
      increased: 0,
      decreased: 0,
      stable: 0
    };

    matches.forEach(match => {
      if (match.B365H && match.B365CH) {
        const diff = match.B365CH - match.B365H;
        if (Math.abs(diff) < 0.1) movements.stable++;
        else if (diff > 0) movements.increased++;
        else movements.decreased++;
      }
    });

    return movements;
  }

  // Form analizi yap (sürpriz maçlar öncesi 3 maç)
  function analyzePreSurpriseForm(matches: Match[], surpriseMatches: Match[], teamName: string) {
    const formPatterns: { [key: string]: number } = {};
    
    surpriseMatches.forEach(sm => {
      const previousMatches = matches
        .filter(m => new Date(m.Date) < new Date(sm.Date))
        .sort((a, b) => new Date(b.Date).getTime() - new Date(a.Date).getTime())
        .slice(0, 3)
        .map(m => {
          const isHome = m.HomeTeam === teamName;
          return isHome 
            ? (m.FTHG > m.FTAG ? 'G' : m.FTHG === m.FTAG ? 'B' : 'M')
            : (m.FTAG > m.FTHG ? 'G' : m.FTAG === m.FTHG ? 'B' : 'M');
        });
      
      if (previousMatches.length === 3) {
        const pattern = previousMatches.join('');
        formPatterns[pattern] = (formPatterns[pattern] || 0) + 1;
      }
    });

    return Object.entries(formPatterns)
      .sort(([,a], [,b]) => b - a)
      .slice(0, 3);
  }

  // Oran paternlerini analiz et
  function analyzeOddPatterns(matches: Match[]) {
    const oddPatterns: { [key: string]: number } = {};
    const bet365Patterns: { [key: string]: { opening: number, closing: number, count: number }[] } = {
      'Home': [],
      'Draw': [],
      'Away': []
    };
    
    matches.forEach(match => {
      // Bet365 açılış-kapanış analizi
      if (match.B365H && match.B365CH) {
        bet365Patterns['Home'].push({
          opening: parseFloat(String(match.B365H)),
          closing: parseFloat(String(match.B365CH)),
          count: 1
        });
      }
      if (match.B365D && match.B365CD) {
        bet365Patterns['Draw'].push({
          opening: parseFloat(String(match.B365D)),
          closing: parseFloat(String(match.B365CD)),
          count: 1
        });
      }
      if (match.B365A && match.B365CA) {
        bet365Patterns['Away'].push({
          opening: parseFloat(String(match.B365A)),
          closing: parseFloat(String(match.B365CA)),
          count: 1
        });
      }

      // Tüm bahis şirketlerinin benzer oranlarını bul
      Object.keys(match).forEach(key => {
        if (key in ODD_TYPES && match[key]) {
          const roundedOdd = Math.round(parseFloat(String(match[key])) * 2) / 2; // 0.5'lik dilimlere yuvarla
          if (!isNaN(roundedOdd)) {
            const pattern = `${ODD_TYPES[key]}: ${roundedOdd}`;
            oddPatterns[pattern] = (oddPatterns[pattern] || 0) + 1;
          }
        }
      });
    });

    // Bet365 paternlerini grupla
    const commonBet365Patterns = Object.entries(bet365Patterns).map(([type, odds]) => {
      const grouped = odds.reduce((acc, curr) => {
        const key = `${curr.opening.toFixed(2)}-${curr.closing.toFixed(2)}`;
        if (!acc[key]) acc[key] = { ...curr };
        else acc[key].count++;
        return acc;
      }, {} as { [key: string]: { opening: number, closing: number, count: number } });

      return {
        type,
        patterns: Object.entries(grouped)
          .map(([key, value]) => ({ ...value, key }))
          .sort((a, b) => b.count - a.count)
          .slice(0, 3)
      };
    });

    return {
      commonOdds: Object.entries(oddPatterns)
        .sort(([,a], [,b]) => b - a)
        .slice(0, 5),
      bet365Patterns: commonBet365Patterns
    };
  }

  // Kırmızı kart ve skor analizi
  function analyzeMatchPatterns(matches: Match[]) {
    const redCardMatches = matches.filter(m => m.RC && m.RC > 0);
    const scoringPatterns = matches.map(m => ({
      score: `${m.FTHG}-${m.FTAG}`,
      htScore: `${m.HTHG}-${m.HTAG}`,
      date: convertExcelDate(m.Date)
    }));

    return {
      redCards: {
        count: redCardMatches.length,
        percentage: (redCardMatches.length / matches.length) * 100,
        timing: redCardMatches
          .map(m => typeof m.Time === 'number' ? m.Time : parseInt(m.Time))
          .filter(time => !isNaN(time))
      },
      scores: scoringPatterns
    };
  }

  // Form analizi yap
  function analyzeForm(matches: Match[], teamName: string) {
    const lastFiveMatches = matches
      .sort((a, b) => new Date(b.Date).getTime() - new Date(a.Date).getTime())
      .slice(0, 5)
      .map(m => {
        const isHome = m.HomeTeam === teamName;
        const score = `${m.FTHG}-${m.FTAG}`;
        const result = isHome 
          ? (m.FTHG > m.FTAG ? 'G' : m.FTHG === m.FTAG ? 'B' : 'M')
          : (m.FTAG > m.FTHG ? 'G' : m.FTAG === m.FTHG ? 'B' : 'M');
        return {
          score,
          result,
          date: convertExcelDate(m.Date),
          redCard: m.RC && m.RC > 0
        };
      });

    return lastFiveMatches;
  }

  // Takım 1 analizi
  if (team1SurpriseCount > 0) {
    const team1Patterns = analyzeMatchPatterns(team1Surprises);
    const team1OddPatterns = analyzeOddPatterns(team1Surprises);
    const team1FormPatterns = analyzePreSurpriseForm(matchData, team1Surprises, team1Name);
    const team1SeasonStats = analyzeSeasonDistribution(team1Surprises);
    const team1GoalTiming = analyzeGoalTiming(team1Surprises);
    const team1OddsMovement = analyzeOddsMovement(team1Surprises);

    // Sezon dağılımı analizi
    const seasonAnalysis = Object.entries(team1SeasonStats)
      .map(([season, count]) => {
        const percentage = Math.round((count / team1SurpriseCount) * 100);
        return `
          <div class="flex items-center gap-4 mb-3">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">${season}</span>
                <span class="text-sm text-gray-600">${count} maç</span>
              </div>
              <div class="h-2 bg-blue-100 rounded-full">
                <div class="h-2 bg-blue-500 rounded-full" style="width: ${percentage}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${percentage}</span>
          </div>
        `;
      }).join('');

    analysis.team1Analysis.push(`
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="flex items-center gap-2 mb-4">
          <Calendar class="text-blue-500" size={20} />
          <span class="font-bold text-gray-700">Sezon Dağılımı:</span>
        </div>
        ${seasonAnalysis}
      </div>
    `);

    // Gol zamanlaması analizi
    const timingPercentages = {
      firstHalf: Math.round((team1GoalTiming.firstHalf / team1SurpriseCount) * 100),
      secondHalf: Math.round((team1GoalTiming.secondHalf / team1SurpriseCount) * 100),
      last15: Math.round((team1GoalTiming.last15 / team1SurpriseCount) * 100)
    };

    analysis.team1Analysis.push(`
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="flex items-center gap-2 mb-4">
          <Clock class="text-blue-500" size={20} />
          <span class="font-bold text-gray-700">Gol Zamanlaması:</span>
        </div>
        <div class="space-y-3">
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">İlk Yarı</span>
                <span class="text-sm text-gray-600">${team1GoalTiming.firstHalf} gol</span>
              </div>
              <div class="h-2 bg-blue-100 rounded-full">
                <div class="h-2 bg-blue-500 rounded-full" style="width: ${timingPercentages.firstHalf}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${timingPercentages.firstHalf}</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">İkinci Yarı</span>
                <span class="text-sm text-gray-600">${team1GoalTiming.secondHalf} gol</span>
              </div>
              <div class="h-2 bg-blue-100 rounded-full">
                <div class="h-2 bg-blue-500 rounded-full" style="width: ${timingPercentages.secondHalf}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${timingPercentages.secondHalf}</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">Son 15 Dakika</span>
                <span class="text-sm text-gray-600">${team1GoalTiming.last15} gol</span>
              </div>
              <div class="h-2 bg-blue-100 rounded-full">
                <div class="h-2 bg-blue-500 rounded-full" style="width: ${timingPercentages.last15}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${timingPercentages.last15}</span>
          </div>
        </div>
      </div>
    `);

    // Oran değişimi analizi
    const movementPercentages = {
      increased: Math.round((team1OddsMovement.increased / team1SurpriseCount) * 100),
      decreased: Math.round((team1OddsMovement.decreased / team1SurpriseCount) * 100),
      stable: Math.round((team1OddsMovement.stable / team1SurpriseCount) * 100)
    };

    analysis.team1Analysis.push(`
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="flex items-center gap-2 mb-4">
          <TrendingUp class="text-blue-500" size={20} />
          <span class="font-bold text-gray-700">Oran Değişimi Analizi:</span>
        </div>
        <div class="space-y-3">
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">Yükselen Oranlar</span>
                <span class="text-sm text-gray-600">${team1OddsMovement.increased} maç</span>
              </div>
              <div class="h-2 bg-green-100 rounded-full">
                <div class="h-2 bg-green-500 rounded-full" style="width: ${movementPercentages.increased}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${movementPercentages.increased}</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">Düşen Oranlar</span>
                <span class="text-sm text-gray-600">${team1OddsMovement.decreased} maç</span>
              </div>
              <div class="h-2 bg-red-100 rounded-full">
                <div class="h-2 bg-red-500 rounded-full" style="width: ${movementPercentages.decreased}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${movementPercentages.decreased}</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">Stabil Oranlar</span>
                <span class="text-sm text-gray-600">${team1OddsMovement.stable} maç</span>
              </div>
              <div class="h-2 bg-gray-100 rounded-full">
                <div class="h-2 bg-gray-500 rounded-full" style="width: ${movementPercentages.stable}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${movementPercentages.stable}</span>
          </div>
        </div>
      </div>
    `);

    // Form analizi
    if (team1FormPatterns.length > 0) {
      const formAnalysis = team1FormPatterns.map(([pattern, count]) => {
        const percentage = Math.round((count / team1SurpriseCount) * 100);
        const formStr = pattern.split('').map(result => {
          const color = result === 'G' ? 'green' : result === 'B' ? 'yellow' : 'red';
          return `<span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-${color}-100 text-${color}-600 font-bold mr-1">${result}</span>`;
        }).join('');
        
        return `
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-2">
              ${formStr}
              <span class="text-gray-600 ml-2">(%${percentage})</span>
            </div>
            <div class="h-2 bg-blue-100 rounded-full">
              <div class="h-2 bg-blue-500 rounded-full" style="width: ${percentage}%"></div>
            </div>
          </div>
        `;
      }).join('');

      analysis.team1Analysis.push(`
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
          <div class="flex items-center gap-2 mb-4">
            <Trophy class="text-yellow-500" size={20} />
            <span class="font-bold text-gray-700">Sürpriz Öncesi Form Örüntüleri:</span>
          </div>
          ${formAnalysis}
          <p class="text-sm text-gray-600 mt-2">
            Bu form grafikleri ${team1Name}'nin sürpriz yapmadan önceki en sık tekrarlanan 3 maçlık form serilerini gösteriyor.
          </p>
        </div>
      `);
    }

    // Bet365 oran analizi
    if (team1OddPatterns.bet365Patterns.length > 0) {
      const oddAnalysis = team1OddPatterns.bet365Patterns.map(({ type, patterns }) => {
        if (patterns.length === 0) return '';
        
        const oddRows = patterns.map(pattern => {
          const percentage = Math.round((pattern.count / team1SurpriseCount) * 100);
          return `
            <div class="flex items-center gap-4 mb-3">
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm text-gray-600">Açılış: <span class="font-bold text-blue-600">${pattern.opening.toFixed(2)}</span></span>
                  <span class="text-sm text-gray-600">Kapanış: <span class="font-bold text-green-600">${pattern.closing.toFixed(2)}</span></span>
                </div>
                <div class="h-2 bg-gray-100 rounded-full">
                  <div class="h-2 bg-green-500 rounded-full" style="width: ${percentage}%"></div>
                </div>
              </div>
              <span class="text-sm font-bold text-gray-700">${pattern.count} kez (%${percentage})</span>
            </div>
          `;
        }).join('');

        return `
          <div class="mb-4">
            <h5 class="font-semibold text-gray-700 mb-3">${type === 'Home' ? 'Ev Sahibi' : type === 'Away' ? 'Deplasman' : 'Beraberlik'} Oranları</h5>
            ${oddRows}
          </div>
        `;
      }).join('');

      analysis.team1Analysis.push(`
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
          <div class="flex items-center gap-2 mb-4">
            <Scale class="text-green-500" size={20} />
            <span class="font-bold text-gray-700">Bet365 Oran Analizi:</span>
          </div>
          ${oddAnalysis}
          <p class="text-sm text-gray-600 mt-3">
            Bu oranlar ${team1Name}'nin sürpriz maçlarında en sık tekrarlanan Bet365 açılış-kapanış oranlarını gösteriyor.
          </p>
        </div>
      `);

      // Ortak oran paternleri
      if (team1OddPatterns.commonOdds.length > 0) {
        const commonOddsStr = team1OddPatterns.commonOdds
          .map(([odd, count]) => {
            const percentage = Math.round((count / team1SurpriseCount) * 100);
            return `
              <div class="flex items-center gap-2 mb-2">
                <span class="px-3 py-1 bg-blue-100 text-blue-600 rounded-full text-sm font-medium">${odd}</span>
                <span class="text-gray-600">%${percentage} (${count} kez)</span>
              </div>
            `;
          })
          .join('');

        analysis.team1Analysis.push(`
          <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
            <div class="flex items-center gap-2 mb-4">
              <TrendingUp class="text-blue-500" size={20} />
              <span class="font-bold text-gray-700">Dikkat Çeken Oranlar:</span>
            </div>
            ${commonOddsStr}
            <p class="text-sm text-gray-600 mt-3">
              Bu oranlar tüm bahis şirketlerinde en sık tekrarlanan değerleri gösteriyor.
            </p>
          </div>
        `);
      }
    }

    // Kırmızı kart analizi
    if (team1Patterns.redCards.count > 0) {
      const percentage = Math.round(team1Patterns.redCards.percentage);
      const timingAvg = team1Patterns.redCards.timing.length > 0
        ? Math.round(team1Patterns.redCards.timing.reduce((a, b) => a + b, 0) / team1Patterns.redCards.timing.length)
        : null;

      analysis.team1Analysis.push(`
        <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
          <div class="flex items-center gap-2 mb-4">
            <AlertTriangle class="text-red-500" size={20} />
            <span class="font-bold text-gray-700">Kırmızı Kart Analizi:</span>
          </div>
          <div class="flex items-center gap-6">
            <div class="flex-1">
              <div class="w-full h-4 bg-red-100 rounded-full">
                <div class="h-4 bg-red-500 rounded-full" style="width: ${percentage}%"></div>
              </div>
              <div class="mt-2 text-center">
                <span class="text-lg font-bold text-red-600">%${percentage}</span>
