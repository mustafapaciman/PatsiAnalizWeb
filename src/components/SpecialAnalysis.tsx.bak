                        result === 'G' ? 'bg-green-100 text-green-600 hover:bg-green-200' :
                        result === 'B' ? 'bg-yellow-100 text-yellow-600 hover:bg-yellow-200' :
                        'bg-red-100 text-red-600 hover:bg-red-200'
                      } transition-colors`}
                    >
                      {result}
