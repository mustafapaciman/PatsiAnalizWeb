    // Gol zamanlaması analizi
    const timingPercentages = {
      firstHalf: Math.round((team2GoalTiming.firstHalf / team2SurpriseCount) * 100),
      secondHalf: Math.round((team2GoalTiming.secondHalf / team2SurpriseCount) * 100),
      last15: Math.round((team2GoalTiming.last15 / team2SurpriseCount) * 100)
