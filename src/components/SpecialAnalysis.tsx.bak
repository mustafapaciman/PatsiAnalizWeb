              </div>
            </div>

            <div>
              <div className="flex items-center justify-between mb-2">
                <label className="text-sm font-medium text-gray-700">Son 3 Maç Formu (Ev)</label>
                {calculationData.homeForm && calculationData.homeForm.length > 0 && (
