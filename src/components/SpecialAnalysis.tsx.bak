              </div>
              <div class="h-2 bg-purple-100 rounded-full">
                <div class="h-2 bg-purple-500 rounded-full" style="width: ${timingPercentages.secondHalf}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${timingPercentages.secondHalf}</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium text-gray-700">Son 15 Dakika</span>
                <span class="text-sm text-gray-600">${team2GoalTiming.last15} gol</span>
              </div>
              <div class="h-2 bg-purple-100 rounded-full">
                <div class="h-2 bg-purple-500 rounded-full" style="width: ${timingPercentages.last15}%"></div>
              </div>
            </div>
            <span class="text-sm font-bold text-gray-700">%${timingPercentages.last15}</span>
          </div>
        </div>
      </div>
    `);

    // Oran değişimi analizi
    const movementPercentages = {
      increased: Math.round((team2OddsMovement.increased / team2SurpriseCount) * 100),
      decreased: Math.round((team2OddsMovement.decreased / team2SurpriseCount) * 100),
      stable: Math.round((team2OddsMovement.stable / team2SurpriseCount) * 100)
    };

    analysis.team2Analysis.push(`
      <div class="bg-white rounded-lg p-4 shadow-sm border border-gray-100">
        <div class="flex items-center gap-2 mb-4">
          <TrendingUp class="text-purple-500" size={20} />
