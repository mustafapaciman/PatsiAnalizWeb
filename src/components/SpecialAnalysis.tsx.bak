                  ))}
                </div>
                {calculationData.awayForm && calculationData.awayForm.length > 0 && (
                  <div className="mt-4">
                    <div className="flex gap-2">
                      {calculationData.awayForm.map((result, idx) => (
                        <div key={idx} className="relative group">
                          <span
                            className={`w-10 h-10 rounded-full flex items-center justify-center font-bold ${
                              result === 'G' ? 'bg-green-100 text-green-600' :
                              result === 'B' ? 'bg-yellow-100 text-yellow-600' :
                              'bg-red-100 text-red-600'
                            }`}
                          >
                            {result}
                          </span>
                          <div className="absolute -top-8 left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                            {idx === 0 ? 'En Eski Maç' : idx === 1 ? 'Orta Maç' : 'En Yeni Maç'}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>

            <div className="flex gap-3">
              <button
                onClick={() => setCalculationResult(calculateSurprisePotential(calculationData))}
                className="flex-1 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg font-medium hover:from-purple-700 hover:to-blue-700 transition-all"
              >
                Sürpriz Potansiyelini Hesapla
              </button>
              
              <button
                onClick={() => {
                  setCalculationData({
                    homeTeam: '',
                    awayTeam: '',
                    homeScores: [],
                    awayScores: [],
                    homeForm: [],
                    awayForm: [],
                    homeOdds: undefined,
                    awayOdds: undefined,
                    drawOdds: undefined
                  });
                  setCalculationResult(null);
                }}
                className="px-4 py-3 bg-gray-100 text-gray-600 rounded-lg font-medium hover:bg-gray-200 transition-all"
              >
                Sıfırla
              </button>
            </div>
          </div>

          {/* Sağ Panel - Sonuçlar */}
          <div className="bg-gradient-to-br from-gray-50 via-purple-50 to-blue-50 rounded-xl p-6 shadow-lg">
            {calculationResult ? (
              <div className="space-y-6">
                {/* Takım Logoları ve VS */}
                <div className="flex items-center justify-center gap-6 bg-white/50 p-6 rounded-xl backdrop-blur-sm">
                  <div className="text-center transform hover:scale-105 transition-transform">
                    <div className="bg-gradient-to-br from-purple-100 to-white p-4 rounded-2xl shadow-md">
                      <TeamLogo name={calculationData.homeTeam} className="w-24 h-24" />
                    </div>
                    <div className="mt-3 font-bold text-gray-700">{calculationData.homeTeam}</div>
                  </div>
                  <div className="w-16 h-16 rounded-full bg-gradient-to-br from-purple-600 to-blue-600 flex items-center justify-center text-white font-bold text-2xl shadow-lg transform hover:scale-110 transition-transform">
                    VS
                  </div>
                  <div className="text-center transform hover:scale-105 transition-transform">
                    <div className="bg-gradient-to-br from-blue-100 to-white p-4 rounded-2xl shadow-md">
                      <TeamLogo name={calculationData.awayTeam} className="w-24 h-24" />
                    </div>
                    <div className="mt-3 font-bold text-gray-700">{calculationData.awayTeam}</div>
                  </div>
                </div>

                {/* En Güvenilir Senaryo */}
                {calculationResult.possibleScenarios.length > 0 && (
                  <div className="bg-white/70 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-purple-100">
                    <h4 className="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-blue-600 mb-4">
                      En Güvenilir Senaryo
                    </h4>
                    <div className="flex items-center justify-between bg-gradient-to-r from-purple-500 to-blue-500 p-6 rounded-xl shadow-md">
                      <span className="text-3xl font-bold text-white">
                        {calculationResult.possibleScenarios[0]}
                      </span>
                      <div className="flex flex-col items-end">
                        <span className="text-2xl font-bold text-white">
                          %{calculationResult.confidence}
                        </span>
                        <span className="text-sm text-white/80">Güven Oranı</span>
                      </div>
                    </div>
                  </div>
                )}

                {/* Diğer Senaryolar */}
                {calculationResult.possibleScenarios.length > 1 && (
                  <div className="bg-white/70 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-blue-100">
                    <h4 className="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-blue-600 mb-4">
                      Diğer Olası Senaryolar
                    </h4>
                    <div className="space-y-3">
                      {calculationResult.possibleScenarios.slice(1).map((scenario, index) => {
                        const confidence = Math.max(0, calculationResult.confidence - ((index + 1) * 15));
                        return (
                          <div key={index} className="relative overflow-hidden">
                            <div className="flex items-center justify-between bg-gradient-to-r from-gray-100 to-blue-50 p-4 rounded-xl">
                              <span className="text-xl font-bold text-gray-700">{scenario}</span>
                              <span className="text-lg font-semibold text-blue-600">
                                %{confidence}
                              </span>
                            </div>
                            <div 
                              className="absolute bottom-0 left-0 h-1 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full transition-all"
                              style={{ width: `${confidence}%` }}
                            />
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}

                {/* Güven Seviyesi */}
                <div className="bg-white/70 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-blue-100">
                  <h4 className="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-blue-600 mb-4">
                    Genel Sürpriz Güven Seviyesi
                  </h4>
                  <div className="relative h-6 bg-gradient-to-r from-gray-100 to-blue-50 rounded-full overflow-hidden shadow-inner">
                    <div
                      className={`absolute top-0 left-0 h-full rounded-full transition-all duration-1000 ${
                        calculationResult.confidence > 70 
                          ? 'bg-gradient-to-r from-green-500 to-emerald-500' 
                          : calculationResult.confidence > 30 
                            ? 'bg-gradient-to-r from-yellow-500 to-orange-500'
                            : 'bg-gradient-to-r from-red-500 to-rose-500'
                      }`}
                      style={{ width: `${calculationResult.confidence}%` }}
                    />
                  </div>
                  <div className="mt-4 text-center">
                    <span className={`text-4xl font-bold ${
                      calculationResult.confidence > 70 
                        ? 'text-green-600' 
                        : calculationResult.confidence > 30 
                          ? 'text-yellow-600'
                          : 'text-red-600'
                    }`}>
                      %{calculationResult.confidence}
                    </span>
                  </div>
                </div>

                {/* Analiz */}
                <div className="bg-white/70 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-purple-100">
                  <h4 className="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-blue-600 mb-4">
                    Analiz
                  </h4>
                  <p className="text-gray-700 leading-relaxed">{calculationResult.explanation}</p>
                </div>

                {/* Uyarılar */}
                {calculationResult.warnings && calculationResult.warnings.length > 0 && (
                  <div className="bg-white/70 backdrop-blur-sm rounded-xl p-6 shadow-lg border border-yellow-100">
                    <h4 className="text-xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-yellow-600 to-red-600 mb-4">
                      Uyarılar
                    </h4>
                    <div className="space-y-3">
                      {calculationResult.warnings.map((warning, idx) => (
                        <div key={idx} className="flex items-center gap-3 text-yellow-700 bg-gradient-to-r from-yellow-50 to-orange-50 p-3 rounded-lg">
                          <AlertTriangle className="text-yellow-500" size={20} />
                          <span>{warning}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            ) : (
              <div className="h-full flex items-center justify-center text-gray-400">
                <p>Hesaplama sonuçları burada görünecek</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );

  return (
    <div className="bg-gradient-to-br from-gray-50 to-white rounded-xl w-full overflow-hidden flex flex-col">
      {/* Header */}
      <div className="p-6 border-b bg-gradient-to-r from-purple-600 to-blue-600 relative">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <Sparkles className="text-white" size={24} />
            <h2 className="text-2xl font-bold text-white">Özel Analiz</h2>
          </div>
          <div className="flex items-center gap-4">
            <div className="flex items-center gap-3">
              <div className="flex items-center gap-4 bg-white/10 p-2 rounded-lg">
                <div className={`flex items-center gap-2 px-3 py-2 rounded-lg transition-all ${
                  analysisMode === 'classic' ? 'bg-white/20 text-white' : 'text-white/60 hover:text-white/80'
                }`}>
                  <Trophy size={16} className={analysisMode === 'classic' ? 'text-yellow-300' : 'text-white/60'} />
                  <span className="text-sm font-medium">2/1 - 1/2</span>
                </div>
                <button
                  onClick={() => setAnalysisMode(prev => prev === 'classic' ? 'draw' : 'classic')}
                  className={`relative w-14 h-7 rounded-full p-1 transition-colors ${
                    analysisMode === 'draw' ? 'bg-green-500/50' : 'bg-white/20'
                  } hover:bg-opacity-75`}
                >
                  <div
                    className={`absolute top-1 w-5 h-5 rounded-full bg-white shadow-md transition-transform duration-300 ${
                      analysisMode === 'draw' ? 'translate-x-7' : 'translate-x-0'
                    }`}
                  />
                </button>
                <div className={`flex items-center gap-2 px-3 py-2 rounded-lg transition-all ${
                  analysisMode === 'draw' ? 'bg-green-500/30 text-white' : 'text-white/60 hover:text-white/80'
                }`}>
                  <Scale size={16} className={analysisMode === 'draw' ? 'text-green-300' : 'text-white/60'} />
                  <span className="text-sm font-medium">1/X - 2/X</span>
                </div>
              </div>
            </div>
            <div className="h-8 w-px bg-white/20"></div>
            <button
              onClick={() => setActiveView('analysis')}
              className={`px-4 py-2 rounded-lg transition-all ${
                activeView === 'analysis'
                  ? 'bg-white text-blue-600'
                  : 'text-white/80 hover:text-white'
              }`}
            >
              Analiz
            </button>
            <button
              onClick={() => setActiveView('calculation')}
              className={`px-4 py-2 rounded-lg transition-all ${
                activeView === 'calculation'
                  ? 'bg-white text-blue-600'
                  : 'text-white/80 hover:text-white'
              }`}
            >
              Sürpriz Hesaplama
            </button>
          </div>
        </div>

        {activeView === 'analysis' && (
          <>
            <div className="mt-4 flex items-center justify-between text-white/90">
              <div className="flex items-center gap-6">
                <button
                  onClick={() => setActiveTab('team1')}
                  className={`flex flex-col items-center transition-all ${
                    activeTab === 'team1' ? 'scale-110' : 'opacity-70 hover:opacity-100'
                  }`}
                >
                  <TeamLogo name={selectedTeam1} className="w-16 h-16" />
                  <span className="mt-2 font-medium">{selectedTeam1}</span>
                </button>
                <span className="text-2xl font-bold">ve</span>
                <button
                  onClick={() => setActiveTab('team2')}
                  className={`flex flex-col items-center transition-all ${
                    activeTab === 'team2' ? 'scale-110' : 'opacity-70 hover:opacity-100'
                  }`}
                >
                  <TeamLogo name={selectedTeam2} className="w-16 h-16" />
                  <span className="mt-2 font-medium">{selectedTeam2}</span>
                </button>
              </div>
              <div className="text-right">
                <button
                  onClick={() => setShowTeamSelection(prev => !prev)}
                  className="text-white/80 hover:text-white transition-colors"
                >
                  {showTeamSelection ? 'Seçimi Gizle' : 'Takımları Değiştir'}
                </button>
              </div>
            </div>
            <div className="absolute left-0 right-0 top-full z-[100] px-6 py-4">
              {renderTeamSelectionCompact()}
            </div>
          </>
        )}
      </div>

      {/* Content */}
      {activeView === 'analysis' ? (
        <div className="flex-1">
          <div className="grid grid-cols-2 gap-6 p-6">
            {/* Sol Taraf - Takım 1 Analizi */}
            <div 
              onClick={() => setActiveTab('team1')}
              className={`transition-all duration-300 transform ${
                activeTab === 'team1' 
                  ? 'opacity-100 scale-105 shadow-xl translate-y-[-8px] bg-white z-10' 
                  : 'opacity-65 scale-95 cursor-not-allowed pointer-events-none'
              }`}
            >
              {selectedTeam1 ? (
                <TeamAnalysisPanel
                  team={selectedTeam1}
                  data={analysisData?.homeTeam}
                  isHome={true}
                  teamData={teamData}
                  activeTab={activeTab}
                  match={selectedMatch}
                  matchData={matchData}
                  analysisMode={analysisMode}
                />
              ) : (
                <div className="bg-gray-50 rounded-xl p-6 text-center text-gray-400">
                  Lütfen Takım 1'i seçin
                </div>
              )}
            </div>

            {/* Sağ Taraf - Takım 2 Analizi */}
            <div 
              onClick={() => setActiveTab('team2')}
              className={`transition-all duration-300 transform ${
                activeTab === 'team2' 
                  ? 'opacity-100 scale-105 shadow-xl translate-y-[-8px] bg-white z-10' 
                  : 'opacity-65 scale-95 cursor-not-allowed pointer-events-none'
              }`}
            >
              {selectedTeam2 ? (
                <TeamAnalysisPanel
                  team={selectedTeam2}
                  data={analysisData?.awayTeam}
                  isHome={false}
                  teamData={teamData}
                  activeTab={activeTab}
                  match={selectedMatch}
                  matchData={matchData}
                  analysisMode={analysisMode}
                />
              ) : (
                <div className="bg-gray-50 rounded-xl p-6 text-center text-gray-400">
                  Lütfen Takım 2'yi seçin
                </div>
              )}
            </div>
          </div>

          {/* AI Analizi */}
          {(selectedTeam1 || selectedTeam2) && (
            <div className="p-6">
              <div className="bg-gradient-to-br from-white via-blue-50 to-indigo-50 rounded-xl shadow-lg">
                <div className="flex items-center gap-3 p-6 border-b border-blue-100">
                  <Brain className="text-blue-600 animate-pulse" size={28} />
                  <h3 className="text-xl font-bold text-gray-800">Yapay Zeka Analizi</h3>
                </div>
                
                {analysisData?.aiAnalysis && (
                  <div className="p-6">
                    {/* Ana Grid Layout */}
                    <div className="grid grid-cols-2 gap-8">
                      {/* Sol Panel - Takım 1 */}
                      {selectedTeam1 && (
                        <div className="bg-white rounded-xl shadow-md overflow-hidden">
                          <div className="bg-gradient-to-r from-blue-600 to-blue-400 p-4">
                            <div className="flex items-center gap-4">
                              <TeamLogo name={selectedTeam1} className="w-12 h-12" />
                              <h4 className="text-lg font-bold text-white">{selectedTeam1} Detaylı Analiz</h4>
                            </div>
                          </div>
                          <div className="p-6 space-y-4">
                            {analysisData.aiAnalysis.team1Analysis.map((analysis, index) => (
                              <div key={index} className="pb-4 border-b border-gray-100 last:border-0">
                                <p className="text-gray-700 leading-relaxed" dangerouslySetInnerHTML={{ __html: analysis }} />
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {/* Sağ Panel - Takım 2 */}
                      {selectedTeam2 && (
                        <div className="bg-white rounded-xl shadow-md overflow-hidden">
                          <div className="bg-gradient-to-r from-purple-600 to-purple-400 p-4">
                            <div className="flex items-center gap-4">
                              <TeamLogo name={selectedTeam2} className="w-12 h-12" />
                              <h4 className="text-lg font-bold text-white">{selectedTeam2} Detaylı Analiz</h4>
                            </div>
                          </div>
                          <div className="p-6 space-y-4">
                            {analysisData.aiAnalysis.team2Analysis.map((analysis, index) => (
                              <div key={index} className="pb-4 border-b border-gray-100 last:border-0">
                                <p className="text-gray-700 leading-relaxed" dangerouslySetInnerHTML={{ __html: analysis }} />
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      ) : (
        renderCalculationTab()
      )}
    </div>
  );
}